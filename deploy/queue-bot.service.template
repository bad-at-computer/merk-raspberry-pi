[Unit]
Description=Queue bot (Telegram + headless Chrome CDP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__
ExecStart=__VENV_PY__ -m queue_bot
Environment=QUEUE_BOT_CONFIG=__CONFIG__
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target